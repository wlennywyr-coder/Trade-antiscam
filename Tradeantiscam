-- Script (pas LocalScript) à placer dans ServerScriptService

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

----------------------------------------------------------------
-- CONFIG : IDs des items qui font fermer le trade
----------------------------------------------------------------
local BLOCKED_ITEMS = {
	[123456789] = true, -- remplace par tes IDs
}

----------------------------------------------------------------
-- Events
----------------------------------------------------------------
-- Serveur -> client : prévient les joueurs (affiché dans l'interface)
local AlertEvent = Instance.new("RemoteEvent")
AlertEvent.Name = "AntiScamAlert"
AlertEvent.Parent = ReplicatedStorage

-- Ton système de trade -> ce script : "un item vient d'être placé"
-- Usage : ServerStorage.AntiScamItemPlaced:Fire(tradeId, itemId, {joueur1, joueur2})
local ItemPlaced = Instance.new("BindableEvent")
ItemPlaced.Name = "AntiScamItemPlaced"
ItemPlaced.Parent = ServerStorage

-- Ce script -> ton système de trade : "ferme ce trade"
-- Connecte-toi dessus : ServerStorage.AntiScamCloseTrade.Event:Connect(function(tradeId) ... end)
local CloseTrade = Instance.new("BindableEvent")
CloseTrade.Name = "AntiScamCloseTrade"
CloseTrade.Parent = ServerStorage

----------------------------------------------------------------
-- Logique
----------------------------------------------------------------
ItemPlaced.Event:Connect(function(tradeId, itemId, participants)
	if typeof(itemId) ~= "number" or type(participants) ~= "table" then
		return
	end

	if BLOCKED_ITEMS[itemId] then
		CloseTrade:Fire(tradeId)

		for _, plr in ipairs(participants) do
			if typeof(plr) == "Instance" and plr:IsA("Player") then
				AlertEvent:FireClient(plr, itemId)
			end
		end

		print(("[ANTISCAM] Trade %s fermé (item %d)"):format(tostring(tradeId), itemId))
	end
end)

print("[ANTISCAM] TradeHandler ON - made by Harmony")

-- Déplacement
local dragging, dragStart, startPos
card.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging, dragStart, startPos = true, input.Position, card.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		card.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)

----------------------------------------------------------------
-- BLOCAGE DES TRADES (heuristique : tout ce qui s'appelle "trade")
----------------------------------------------------------------
local blocked = 0
local function onBlocked()
	blocked += 1
	counter.Text = "Trades bloqués : " .. blocked
	counter.TextColor3 = RED
	stroke.Color = RED
	task.delay(3, function()
		counter.TextColor3 = Color3.fromRGB(111, 143, 126)
		stroke.Color = GREEN
	end)
end

local function isTradeName(name)
	return string.find(string.lower(name), "trade", 1, true) ~= nil
end

-- 1) Coupe les listeners des RemoteEvents de trade (les demandes n'arrivent plus au jeu)
local function neutralize(obj)
	if obj:IsA("RemoteEvent") and isTradeName(obj.Name) then
		if getconnections then
			pcall(function()
				for _, c in ipairs(getconnections(obj.OnClientEvent)) do
					c:Disable()
				end
			end)
		end
		obj.OnClientEvent:Connect(onBlocked)
	end
end

for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
	neutralize(d)
end
ReplicatedStorage.DescendantAdded:Connect(neutralize)

-- 2) Cache toute fenêtre de trade qui apparaît dans l'interface du jeu
local function hideTradeGui(obj)
	if obj:IsDescendantOf(gui) or not isTradeName(obj.Name) then
		return
	end
	if obj:IsA("ScreenGui") then
		obj.Enabled = false
		obj:GetPropertyChangedSignal("Enabled"):Connect(function()
			if obj.Enabled then
				obj.Enabled = false
				onBlocked()
			end
		end)
	elseif obj:IsA("GuiObject") then
		obj.Visible = false
		obj:GetPropertyChangedSignal("Visible"):Connect(function()
			if obj.Visible then
				obj.Visible = false
				onBlocked()
			end
		end)
	end
end

for _, d in ipairs(playerGui:GetDescendants()) do
	hideTradeGui(d)
end
playerGui.DescendantAdded:Connect(hideTradeGui)


-- Function to create the trade interface for a player
local function createTradeInterface(player)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TradeInterface"
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 200)
    frame.Position = UDim2.new(0.5, -150, 0.5, -100)
    frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.Text = "ANTI SCAM"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.BackgroundTransparency = 1
    title.Parent = frame

    local tradeButton = Instance.new("TextButton")
    tradeButton.Size = UDim2.new(0.8, 0, 0, 30)
    tradeButton.Position = UDim2.new(0.1, 0, 0.2, 0)
    tradeButton.Text = "ON"
    tradeButton.TextColor3 = Color3.new(1, 1, 1)
    tradeButton.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    tradeButton.Parent = frame

    tradeButton.MouseButton1Click:Connect(function()
        -- Logic to initiate a trade
        local tradeId = "trade123"
        local itemId = "item123"
        TradeEvent:FireServer(tradeId, itemId)
    end)
end

